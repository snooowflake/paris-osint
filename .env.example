# Exemple générique : copier en .env (0600, hors Git) sur la machine choisie.
BIND_HOST=127.0.0.1
PORT=4174
APP_ORIGIN=http://127.0.0.1:4174
VPN_ONLY=0
# Pour un accès VPN interne HTTP : hôte IPv4 privé exact, origine identique,
# VPN_ONLY=1 et CIDR privés explicitement autorisés, séparés par virgules.
VPN_CIDRS=
# Pour HTTPS natif ou le reverse proxy public central déjà autorisé :
TLS_CERT=
TLS_KEY=
# Aucun secret ci-dessous ne doit être exposé dans Vite, Git ou les logs.
AIRPARIF_API_KEY=
TOMTOM_API_KEY=
PRIM_API_KEY=
PRIM_LINE_IDS=
# Pas de service cloud payant ni d'IA activés par défaut.
