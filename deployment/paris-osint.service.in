[Unit]
Description=Paris OSINT - carte et collecteurs publics
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=@@APP_USER@@
Group=@@APP_USER@@
WorkingDirectory=@@PROJECT_DIR@@
EnvironmentFile=@@PROJECT_DIR@@/.env
Environment=NODE_ENV=production
ExecStart=@@PROJECT_DIR@@/var/runtime/node-v24.19.0-linux-x64/bin/node server/paris/server.mjs
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=@@PROJECT_DIR@@
ReadWritePaths=@@PROJECT_DIR@@/var
ReadOnlyPaths=@@PROJECT_DIR@@/var/runtime
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=768M
CPUQuota=80%
TasksMax=64
LimitNOFILE=4096
LogNamespace=paris-osint
LogRateLimitIntervalSec=30s
LogRateLimitBurst=40
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
